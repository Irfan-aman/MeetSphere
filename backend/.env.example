# --- Server ---
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/meetsphere locally)
MONGODB_URI=mongodb://127.0.0.1:27017/meetsphere

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# --- Gemini (server-side only, never expose to the browser) ---
GEMINI_API_KEY=
# Model name is config, not a secret. Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-2.5-flash

# Max participants per room (WebRTC mesh: keep this small)
MAX_PARTICIPANTS=8
